# Example environment variables for FastAPIProject6

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/news_platform
DB_PASSWORD=your_db_password

# Redis
REDIS_URL=redis://redis:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# JWT
SECRET_KEY=your-jwt-secret-key

# Test admin login
TEST_ADMIN_PASSWORD=your-admin-password

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@newsplatform.com
PGADMIN_DEFAULT_PASSWORD=your-pgadmin-password
